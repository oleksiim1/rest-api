<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Recipes\Domain\Recipe" table="recipes">

        <id name="id" type="recipe_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <embedded name="title" class="App\Recipes\Domain\RecipeTitle" use-column-prefix="false"/>
        <embedded name="description" class="App\Recipes\Domain\RecipeDescription" use-column-prefix="false"/>

        <!--
            Recipe::update() swaps the whole list, so Doctrine deletes the old rows before inserting
            the new ones (orphan-removal). EAGER loads the ingredients of a page of recipes in one
            batched query instead of one query per recipe. Detaching a recipe detaches its rows too,
            which DoctrineRecipeRepository::all() relies on to release each batch.
        -->
        <one-to-many field="ingredients" target-entity="App\Recipes\Domain\RecipeIngredient"
                     mapped-by="recipe" orphan-removal="true" fetch="EAGER">
            <cascade>
                <cascade-persist/>
                <cascade-detach/>
            </cascade>
            <order-by>
                <order-by-field name="position" direction="ASC"/>
            </order-by>
        </one-to-many>
    </entity>
</doctrine-mapping>
